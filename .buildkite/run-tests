#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true
#
# run-tests --slice — run this parallel job's slice of the test corpus
# (test/*.rb and packages/*/test/*.rb) against an already-built compiler.
#
# The slice is the Makefile's own TEST_SHARD=k/n, the same pick ci.yml uses,
# so which fixtures the build gates on (promote_*, int64-only fixtures on a
# 32-bit target, packages whose system headers are missing) and how they are
# split stay in one place. test-corpus-summary tallies the slice and exits
# non-zero on any FAIL or ERR.
#
# It does NOT build the compiler: bin/spinel and lib/libspinel_rt.a come from
# the build step's artifacts. `make -o` marks every prebuilt file assume-old,
# so make links what was downloaded and never descends into the toolchain
# build — a shard needs no vendored prism/rbs sources. That is also why this
# calls test-corpus-summary directly rather than test-corpus: -o is not
# passed down to the sub-make test-corpus starts.
#
# See ensure-clang for why the shebang needs `-S`.

require "etc"
require "fileutils"

def die(msg)
  warn "run-tests: #{msg}"
  exit 2
end

die("usage: #{File.basename($PROGRAM_NAME)} --slice") unless ARGV == ["--slice"]

# SHARD=k/n names the slice outright: a step that keeps a cache volume per
# slice is one step per slice, not a `parallelism:` step.
shard = ENV["SHARD"].to_s
if shard.empty?
  count = ENV["BUILDKITE_PARALLEL_JOB_COUNT"].to_s
  index = ENV["BUILDKITE_PARALLEL_JOB"].to_s
  die("--slice needs SHARD=k/n or BUILDKITE_PARALLEL_JOB(_COUNT) (parallelism: N)") if count.empty? || index.empty?
  shard = "#{index.to_i + 1}/#{count}"
end

# Everything the test rules link against: the compiler, both runtimes, and the
# bundled package objects in both variants.
prebuilt = ["bin/spinel", "lib/libspinel_rt.a", "lib/libspinel_rt_mt.a", *Dir.glob("packages/*/*.o")]
prebuilt.first(2).each { |f| die("missing prebuilt #{f} — download the build artifact first") unless File.exist?(f) }

# The tally reads every stamp in the directory, so start from an empty one.
FileUtils.rm_rf("build/test-results")

# -O1 compiles each generated gcc test far faster than -O0; clang steps set
# OPT=-O0 (see pipeline.yml).
opt = ENV["OPT"].to_s.empty? ? "-O1" : ENV["OPT"]
puts "run-tests: shard #{shard}"

make = ["make", "-j#{Etc.nprocessors}"]
prebuilt.select { |f| File.exist?(f) }.each { |f| make.push("-o", f) }
exec(*make, "OPT=#{opt}", "TEST_SHARD=#{shard}", "test-corpus-summary")
