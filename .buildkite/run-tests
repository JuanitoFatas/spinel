#!/usr/bin/env bash
# run-tests — run a subset of the test/*.rb golden-diff fixtures against an
# already-built compiler, then tally just that subset.
#
# Two ways to call it:
#   .buildkite/run-tests test/a.rb test/b.rb ...   # explicit fixtures
#   .buildkite/run-tests --slice                   # this parallel job's slice
#
# --slice reads Buildkite's BUILDKITE_PARALLEL_JOB / _JOB_COUNT and takes a
# stable modulo slice of `test/*.rb`, so each parallel job runs a disjoint
# share. The split is deterministic (sorted filenames), which is enough for
# spinel's roughly-uniform fixtures — the heavy/uneven targets (bench,
# optcarrot) live outside test/*.rb.
#
# It does NOT build the compiler: it expects bin/spinel and lib/libspinel_rt.a
# to already exist (from `make all`, or downloaded as a build artifact). The
# `make -o` flags below mark those two as assume-old so make uses them as-is
# and never descends into the toolchain build — a test node therefore needs no
# vendored prism/rbs sources, only the checkout + the two artifacts + cc + ruby.
set -uo pipefail

SPINEL=bin/spinel
RT_LIB=lib/libspinel_rt.a
OPT=${OPT:--O1}   # -O1 compiles each generated test ~3x faster than -O0; see Makefile.

die() { echo "run-tests: $*" >&2; exit 2; }

[ "$#" -ge 1 ] || die "usage: $0 (--slice | test/a.rb [test/b.rb ...])"

# Resolve --slice into an explicit fixture list before anything else.
if [ "$1" = "--slice" ]; then
  : "${BUILDKITE_PARALLEL_JOB_COUNT:?--slice needs BUILDKITE_PARALLEL_JOB_COUNT (set parallelism: N on the step)}"
  : "${BUILDKITE_PARALLEL_JOB:?--slice needs BUILDKITE_PARALLEL_JOB (set parallelism: N on the step)}"
  # BUILDKITE_PARALLEL_JOB is 0-indexed; (NR-1) % count == index gives a stable,
  # disjoint partition that covers every file exactly once across all jobs.
  slice=$(ls test/*.rb | sort | awk \
    -v n="$BUILDKITE_PARALLEL_JOB_COUNT" -v i="$BUILDKITE_PARALLEL_JOB" \
    '(NR - 1) % n == i')
  set -f                 # fixture names have no glob chars, but be safe
  set -- $slice
  set +f
  echo "run-tests: shard $((BUILDKITE_PARALLEL_JOB + 1))/$BUILDKITE_PARALLEL_JOB_COUNT — $# fixtures"
fi

for f in "$SPINEL" "$RT_LIB"; do
  [ -e "$f" ] || die "missing prebuilt $f — run 'make all' or download the build artifact first"
done

# Map each test/X.rb -> build/test-results/X.ok, wiping any stale stamp so the
# tally only reflects this run. (`make test` always runs fresh for the same
# reason — a stale PASS stamp was a known foot-gun; see Makefile.)
targets=()
n_in=0
for f in "$@"; do
  case "$f" in
    test/*.rb) ;;
    *) echo "run-tests: skipping non-fixture arg '$f'" >&2; continue ;;
  esac
  n_in=$((n_in + 1))
  ok="build/test-results/${f#test/}"
  ok="${ok%.rb}.ok"
  rm -f "$ok" "$ok.diff"
  targets+=("$ok")
done

[ "${#targets[@]}" -gt 0 ] || die "no fixtures to run (matched $n_in args)"

# Build only the requested .ok targets. -o on the two prebuilt artifacts keeps
# make from rebuilding the toolchain. Each recipe returns 0 even on a failing
# fixture (status goes into the .ok file), so we tally afterward rather than
# relying on make's exit code; surface a hard make failure separately.
if ! make ${JOBS:+-j"$JOBS"} -o "$RT_LIB" -o "$SPINEL" OPT="$OPT" "${targets[@]}"; then
  echo "run-tests: make exited non-zero (see output above)" >&2
fi

pass=0; fail=0; err=0; rc=0
for ok in "${targets[@]}"; do
  bn=$(basename "$ok" .ok)
  if [ ! -f "$ok" ]; then
    echo "ERR:  $bn (no result stamp — make did not build it)"; err=$((err + 1)); rc=1; continue
  fi
  case "$(cat "$ok")" in
    PASS) pass=$((pass + 1)) ;;
    FAIL) echo "FAIL: $bn"; [ -f "$ok.diff" ] && head -40 "$ok.diff"; fail=$((fail + 1)); rc=1 ;;
    ERR)  echo "ERR:  $bn (compile/link failed)"; err=$((err + 1)); rc=1 ;;
    *)    echo "ERR:  $bn (unrecognized status '$(cat "$ok")')"; err=$((err + 1)); rc=1 ;;
  esac
done

echo "Tests: $pass pass, $fail fail, $err error (of ${#targets[@]})"
exit $rc
