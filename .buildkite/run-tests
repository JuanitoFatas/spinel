#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true
#
# run-tests — run a subset of the test/*.rb golden-diff fixtures against an
# already-built compiler, then tally just that subset.
#
# Two ways to call it:
#   .buildkite/run-tests test/a.rb test/b.rb ...   # explicit fixtures
#   .buildkite/run-tests --slice                   # this parallel job's slice
#
# --slice reads Buildkite's BUILDKITE_PARALLEL_JOB / _JOB_COUNT and takes a
# stable modulo slice of `test/*.rb`, so each parallel job runs a disjoint
# share. The split is deterministic (sorted filenames), which is enough for
# spinel's roughly-uniform fixtures — the heavy/uneven targets (bench,
# optcarrot) live outside test/*.rb.
#
# It does NOT build the compiler: it expects bin/spinel and lib/libspinel_rt.a
# to already exist (from `make all`, or downloaded as a build artifact). The
# `make -o` flags below mark those two as assume-old so make uses them as-is
# and never descends into the toolchain build — a test node therefore needs no
# vendored prism/rbs sources, only the checkout + the two artifacts + cc + ruby.
#
# Ruby (not bash) so the slice/tally runs in-process: no ls|sort|awk, no
# per-target basename/cat/rm/head subprocesses — just the one `make`. See
# ensure-clang for why the shebang needs `-S`.

SPINEL = "bin/spinel"
RT_LIB = "lib/libspinel_rt.a"

# -O1 compiles each generated test ~3x faster than -O0; see Makefile.
OPT = (opt = ENV["OPT"]).nil? || opt.empty? ? "-O1" : opt

def die(msg)
  warn "run-tests: #{msg}"
  exit 2
end

die("usage: #{File.basename($PROGRAM_NAME)} (--slice | test/a.rb [test/b.rb ...])") if ARGV.empty?

# Resolve --slice into an explicit fixture list before anything else.
if ARGV[0] == "--slice"
  count = ENV["BUILDKITE_PARALLEL_JOB_COUNT"]
  index = ENV["BUILDKITE_PARALLEL_JOB"]
  die("--slice needs BUILDKITE_PARALLEL_JOB_COUNT (set parallelism: N on the step)") if count.nil? || count.empty?
  die("--slice needs BUILDKITE_PARALLEL_JOB (set parallelism: N on the step)") if index.nil? || index.empty?
  count = count.to_i
  index = index.to_i
  # BUILDKITE_PARALLEL_JOB is 0-indexed; position % count == index gives a
  # stable, disjoint partition covering every file exactly once across all jobs.
  fixtures = Dir.glob("test/*.rb").sort
  ARGV.replace(fixtures.select.with_index { |_, pos| pos % count == index })
  puts "run-tests: shard #{index + 1}/#{count} — #{ARGV.size} fixtures"
end

[SPINEL, RT_LIB].each do |f|
  die("missing prebuilt #{f} — run 'make all' or download the build artifact first") unless File.exist?(f)
end

# Map each test/X.rb -> build/test-results/X.ok, wiping any stale stamp so the
# tally only reflects this run. (`make test` always runs fresh for the same
# reason — a stale PASS stamp was a known foot-gun; see Makefile.)
targets = []
n_in = 0
ARGV.each do |f|
  unless File.fnmatch?("test/*.rb", f, File::FNM_PATHNAME)
    warn "run-tests: skipping non-fixture arg '#{f}'"
    next
  end
  n_in += 1
  ok = "build/test-results/#{f.delete_prefix("test/").delete_suffix(".rb")}.ok"
  File.delete(ok) if File.exist?(ok)
  File.delete("#{ok}.diff") if File.exist?("#{ok}.diff")
  targets << ok
end

die("no fixtures to run (matched #{n_in} args)") if targets.empty?

# Build only the requested .ok targets. -o on the two prebuilt artifacts keeps
# make from rebuilding the toolchain. Each recipe returns 0 even on a failing
# fixture (status goes into the .ok file), so we tally afterward rather than
# relying on make's exit code; surface a hard make failure separately.
make = ["make"]
make << "-j#{ENV["JOBS"]}" unless (jobs = ENV["JOBS"]).nil? || jobs.empty?
make.push("-o", RT_LIB, "-o", SPINEL, "OPT=#{OPT}", *targets)
warn "run-tests: make exited non-zero (see output above)" unless system(*make)

pass = fail = err = 0
rc = 0
targets.each do |ok|
  bn = File.basename(ok, ".ok")
  unless File.file?(ok)
    puts "ERR:  #{bn} (no result stamp — make did not build it)"
    err += 1
    rc = 1
    next
  end
  case (status = File.read(ok).strip)
  when "PASS"
    pass += 1
  when "FAIL"
    puts "FAIL: #{bn}"
    # head -40 of the diff, read lazily so a huge diff isn't slurped whole.
    File.foreach("#{ok}.diff").first(40).each { |l| print l } if File.file?("#{ok}.diff")
    fail += 1
    rc = 1
  when "ERR"
    puts "ERR:  #{bn} (compile/link failed)"
    err += 1
    rc = 1
  else
    puts "ERR:  #{bn} (unrecognized status '#{status}')"
    err += 1
    rc = 1
  end
end

puts "Tests: #{pass} pass, #{fail} fail, #{err} error (of #{targets.size})"
exit rc
