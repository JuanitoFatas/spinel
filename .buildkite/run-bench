#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true
#
# run-bench --slice — run this parallel job's modulo slice of the benchmarks
# against an already-built compiler. Mirrors run-tests --slice: a stable
# position % count == index partition over benchmark/*.rb, so each shard runs a
# disjoint share. The Makefile's `bench` target does the actual compile/run/diff
# and tally; we just hand it BENCHES= and let it exit non-zero on failure.
#
# Expects bin/spinel + lib/libspinel_rt.a to already exist (downloaded as
# artifacts); `make -o` marks them assume-old so the toolchain isn't rebuilt.
# See ensure-clang for why the shebang needs `-S`.

unless ARGV[0] == "--slice"
  warn "usage: #{File.basename($PROGRAM_NAME)} --slice"
  exit 2
end

count = ENV["BUILDKITE_PARALLEL_JOB_COUNT"]
index = ENV["BUILDKITE_PARALLEL_JOB"]
(warn "run-bench: --slice needs BUILDKITE_PARALLEL_JOB_COUNT"; exit 1) if count.nil? || count.empty?
(warn "run-bench: --slice needs BUILDKITE_PARALLEL_JOB"; exit 1) if index.nil? || index.empty?
count = count.to_i
index = index.to_i

slice = Dir.glob("benchmark/*.rb").sort.select.with_index { |_, pos| pos % count == index }
shard = "#{index + 1}/#{count}"

if slice.empty?
  puts "run-bench: shard #{shard} — no benchmarks in slice"
  exit 0
end
puts "run-bench: shard #{shard} — #{slice.size} benchmarks"

# No OPT override: bench keeps the Makefile default -O2, matching ci.yml. BENCHES
# is one space-joined argv element, exactly like `make bench BENCHES="a.rb b.rb"`;
# make word-splits the value into the benchmark list. exec hands make our exit code.
exec("make", "-o", "bin/spinel", "-o", "lib/libspinel_rt.a", "BENCHES=#{slice.join(" ")}", "bench")
