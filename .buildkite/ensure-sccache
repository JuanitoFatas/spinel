#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true
#
# Install sccache (onto /usr/local/bin) for the gcc tracks. common.mk wraps CC
# with sccache whenever it is on PATH, so installing it is all the build needs.
# Its store is SCCACHE_DIR, which the step keeps on a Buildkite cache volume.
# See ensure-clang for why the shebang needs `-S`.

VERSION = "0.18.0"

unless system("sccache", "--version", out: File::NULL, err: File::NULL)
  name = "sccache-v#{VERSION}-x86_64-unknown-linux-musl"
  url = "https://github.com/mozilla/sccache/releases/download/v#{VERSION}/#{name}.tar.gz"
  system("sh", "-c", "curl -fsSL #{url} | tar -xz -C /usr/local/bin --strip-components=1 #{name}/sccache") or
    abort("ensure-sccache: install failed")
end
system("sccache", "--version") or abort("ensure-sccache: sccache missing after install")
